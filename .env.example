# Vaango - Environment Configuration
# Copy this file to .env and fill in your Supabase project values.

# SUPABASE (required for live auth and database)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_EMAIL=mailto:your@email.com

# SUPABASE SETUP CHECKLIST (complete before testing OTP)
# 1. Authentication > Providers > Email:
#    Enable Email provider and Confirm email.
# 2. Authentication > URL Configuration:
#    Site URL: http://localhost:3000 (dev) or https://vaango.in (prod)
#    Redirect URLs: add http://localhost:3000/** (dev)
# 3. Authentication > Email Templates > Magic Link:
#    Subject: Your Vaango Verification Code: {{ .Token }}
#    Body: paste supabase/email_templates/email_verification.html
# 4. Authentication > SMTP Settings (for more than 3 emails/hour):
#    Configure Resend, SendGrid, AWS SES, or Postmark.
# 5. Database > Run migrations:
#    Apply all files in supabase/migrations/ in order.
#    Verify the on_auth_user_created trigger exists.
#
# If these variables are not set, Vaango runs in offline preview mode.
# Use code 123456 for all OTP prompts.
